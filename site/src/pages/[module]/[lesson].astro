---
// Страница урока. Порядок блоков — «Анатомия урока» из плана.
import AnnotatedExample from "../../components/AnnotatedExample.astro";
import CSharpBridge from "../../components/CSharpBridge.astro";
import LessonHeader from "../../components/LessonHeader.astro";
import LessonStatus from "../../components/LessonStatus.astro";
import Playground from "../../components/Playground.astro";
import Quiz from "../../components/Quiz.astro";
import TaskBlock from "../../components/TaskBlock.astro";
import VizPlayer from "../../components/VizPlayer.astro";
import Base from "../../layouts/Base.astro";
import { allLessons, lessonUrl, type Lesson } from "../../lib/content";
import { renderLessonBody } from "../../lib/markdown";

export function getStaticPaths() {
  const lessons = allLessons();
  return lessons.map((lesson, i) => ({
    params: { module: lesson.module.slug, lesson: lesson.slug },
    props: { lesson, prev: lessons[i - 1], next: lessons[i + 1] },
  }));
}

interface Props {
  lesson: Lesson;
  prev?: Lesson;
  next?: Lesson;
}
const { lesson, prev, next } = Astro.props;
const sections = await renderLessonBody(lesson.body);
---

<Base title={`${lesson.meta.title} — Go для C#-разработчика`} description={lesson.meta.summary}>
  <article class="lesson">
    <LessonHeader lesson={lesson} />
    <div class="prose intro" set:html={sections.intro} />

    <AnnotatedExample source={lesson.example.source} output={lesson.example.output} tests={lesson.example.tests} mod={lesson.example.mod} />

    {sections.csharp && <CSharpBridge differences={sections.csharp} files={lesson.csharp} />}

    <Playground lesson={lesson.id} example={lesson.example} race={lesson.meta.runner?.race} vulncheck={!!lesson.meta.govulncheck} />

    {
      sections.internals && (
        <section aria-label="Под капотом">
          <h2>Под капотом</h2>
          <div class="prose" set:html={sections.internals} />
          {lesson.hasViz && <VizPlayer lesson={lesson} />}
        </section>
      )
    }

    {
      sections.pitfalls.length > 0 && (
        <section aria-label="Ловушки">
          <h2>Ловушки для C#-ника</h2>
          {sections.pitfalls.map((p) => (
            <div class="pitfall">
              <h3 set:html={p.title} />
              <div class="prose" set:html={p.html} />
            </div>
          ))}
        </section>
      )
    }

    <Quiz lesson={lesson.id} questions={lesson.quiz} />

    {lesson.task && sections.task && <TaskBlock lesson={lesson.id} statement={sections.task} task={lesson.task} fix={lesson.meta.taskKind === "fix"} />}

    <LessonStatus lesson={lesson.id} quizIds={lesson.quiz.map((q) => q.id)} hasTask={!!lesson.task} />

    <footer class="lesson-footer">
      {
        lesson.meta.docs && lesson.meta.docs.length > 0 && (
          <div class="docs">
            <h2>Документация</h2>
            <ul>
              {lesson.meta.docs.map((d) => (
                <li>
                  <a href={d.url}>{d.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <nav class="pager" aria-label="Навигация по урокам">
        {
          prev ? (
            <a href={lessonUrl(prev)} rel="prev">
              ← {prev.meta.title}
            </a>
          ) : (
            <span />
          )
        }
        <a href="/">Оглавление</a>
        {
          next ? (
            <a href={lessonUrl(next)} rel="next">
              {next.meta.title} →
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </footer>
  </article>
</Base>

<style>
  .intro {
    font-size: 1.05rem;
    max-width: 46rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
