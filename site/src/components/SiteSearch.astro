---
// Поиск по курсу в шапке. Индекс — /search-index.json.gz, логика — lib/search.ts,
// поведение поля — lib/client/search-ui.ts. «/» с любого места фокусирует поле.
// На узком экране поле спрятано за кнопкой-лупой.
const lens =
  '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
---

<div class="site-search" data-search>
  <button type="button" class="search-open" data-search-open aria-label="Поиск по курсу" aria-expanded="false" aria-controls="site-search-box">
    <Fragment set:html={lens} />
  </button>
  <div class="search-box" id="site-search-box">
    <span class="search-lens" aria-hidden="true"><Fragment set:html={lens} /></span>
    <input
      id="site-search-input"
      class="search-input"
      type="search"
      role="combobox"
      aria-label="Поиск по курсу"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="site-search-list"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder="Поиск по курсу"
      data-search-input
    />
    <kbd class="search-kbd" aria-hidden="true" title="Клавиша / — к поиску">/</kbd>
    <button type="button" class="search-close" data-search-close aria-label="Закрыть поиск">✕</button>
    <ul id="site-search-list" class="search-list" role="listbox" aria-label="Результаты поиска" data-search-list hidden></ul>
    <p class="sr-only" aria-live="polite" data-search-status></p>
  </div>
</div>

<script>
  import { mountSearch } from "../lib/client/search-ui.ts";

  for (const root of document.querySelectorAll<HTMLElement>("[data-search]")) mountSearch(root);
</script>

<style>
  .site-search {
    position: relative;
    flex: 0 1 22rem;
    min-width: 0;
  }
  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-lens {
    position: absolute;
    left: 0.6rem;
    display: flex;
    color: var(--fg-muted);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    min-width: 0;
    font: inherit;
    font-size: 0.95rem;
    padding: 0.35rem 2rem 0.35rem 2.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--fg);
  }
  .search-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
    background: var(--bg);
  }
  /* Свой крестик у type=search не нужен: Esc очищает поле. */
  .search-input::-webkit-search-cancel-button {
    display: none;
  }
  .search-kbd {
    position: absolute;
    right: 0.6rem;
    color: var(--fg-muted);
    pointer-events: none;
  }
  .search-input:focus ~ .search-kbd {
    display: none;
  }
  .search-open,
  .search-close {
    display: none;
    padding: 0.3rem 0.55rem;
    line-height: 1;
  }
  .search-open {
    align-items: center;
  }
  .search-list {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 20;
    width: min(34rem, calc(100vw - 2rem));
    max-height: min(70vh, 32rem);
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
  }
  .search-list :global([role="option"]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.1rem;
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .search-list :global([role="option"]:hover),
  .search-list :global([aria-selected="true"]) {
    background: var(--bg-soft);
  }
  .search-list :global([aria-selected="true"]) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .search-list :global(.search-title) {
    font-weight: 600;
  }
  .search-list :global(.search-where) {
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .search-list :global(.search-snippet) {
    font-size: 0.85rem;
    color: var(--fg-muted);
    overflow-wrap: anywhere;
  }
  .search-list :global(mark) {
    background: color-mix(in srgb, var(--warn-border) 40%, transparent);
    color: inherit;
    border-radius: 2px;
  }
  .search-list :global(.search-empty) {
    padding: 0.5rem 0.6rem;
    color: var(--fg-muted);
  }

  /* Узкий экран: лупа; по нажатию поле занимает всю шапку. */
  @media (max-width: 640px) {
    .site-search {
      position: static;
      flex: 0 0 auto;
    }
    .search-open {
      display: inline-flex;
    }
    .search-box {
      display: none;
    }
    .site-search:global(.is-open) .search-box {
      display: flex;
      gap: 0.4rem;
      position: absolute;
      inset: 0;
      z-index: 10;
      padding: 0 1rem;
      background: var(--bg);
    }
    .site-search:global(.is-open) .search-lens {
      left: 1.6rem;
    }
    .site-search:global(.is-open) .search-close {
      display: inline-block;
    }
    .search-kbd {
      display: none;
    }
    .search-list {
      top: 100%;
      left: 0.5rem;
      right: 0.5rem;
      width: auto;
    }
  }
</style>
