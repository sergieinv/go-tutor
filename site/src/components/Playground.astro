---
// Песочница: редактор с кодом примера, запуск в runner, вывод.
// Пример с *_test.go запускается через go test: редактируются и main.go, и тесты,
// а кнопки запускают тесты, бенчмарки, fuzzing и покрытие. У примера со своим go.mod
// он тоже редактируется; govulncheck проверяет модуль по снимку базы уязвимостей.
// Урокам с runner.labs runner на каждый запуск создаёт пустую базу профиля labs.
// Без JS остаётся подсвеченный код — пример читается и так.
import type { Example } from "../lib/content";
import { highlight, scriptJSON } from "../lib/markdown";

interface Props {
  lesson: string;
  example: Example;
  race?: boolean;
  vulncheck?: boolean;
  labs?: ("postgres" | "mysql")[];
}
const { lesson, example, race, vulncheck, labs = [] } = Astro.props;
const labInfo = { postgres: ["PostgreSQL", "POSTGRES_DSN"], mysql: ["MySQL", "MYSQL_DSN"] } as const;
const editable: Record<string, string> = {
  "main.go": example.source,
  ...example.tests,
  ...(example.mod ? { "go.mod": example.mod } : {}),
};
const testMode = Object.keys(example.tests).length > 0;
const multi = Object.keys(editable).length > 1;
const fallbacks = await Promise.all(
  Object.entries(editable).map(async ([name, src]) => ({ name, html: await highlight(src.trimEnd(), "go") })),
);
const files = example.files;
---

<section class="playground" aria-label="Песочница" data-playground data-lesson={lesson} data-test-mode={testMode ? "" : undefined}>
  <h2>Песочница</h2>
  <p class="muted hint">
    {testMode ? "Измените код или тесты и запустите их." : "Измените пример и запустите его."}
    <kbd>Ctrl</kbd>/<kbd>⌘</kbd>+<kbd>Enter</kbd> — {testMode ? "тесты" : "запуск"}, <kbd>Tab</kbd> — отступ,
    <kbd>Esc</kbd> и затем <kbd>Tab</kbd> — выйти из редактора.
    {race && <> Код собирается с детектором гонок <code>-race</code>.</>}
  </p>
  {
    labs.length > 0 && (
      <p class="labs-note">
        Пример работает на настоящей базе: {labs.map((l, i) => <>{i > 0 && " и "}{labInfo[l][0]}</>)} из профиля labs. Запустите
        учебник командой <code>docker compose --profile labs up</code>. На каждый запуск runner создаёт пустую базу и
        передаёт её адрес в {labs.map((l, i) => <>{i > 0 && " и "}<code>{labInfo[l][1]}</code></>)}, а после запуска
        удаляет.
      </p>
    )
  }
  <script type="application/json" data-initial set:html={scriptJSON(editable)} />
  <script type="application/json" data-files set:html={scriptJSON(files)} />
  {
    fallbacks.map((f) => (
      <figure class="file-editor">
        {multi && (
          <figcaption>
            <code>{f.name}</code>
          </figcaption>
        )}
        <div class="editor" data-editor={f.name}>
          <Fragment set:html={f.html} />
        </div>
      </figure>
    ))
  }
  {
    Object.keys(files).length > 0 && (
      <details class="extra-files">
        <summary>
          Файлы рядом с <code>main.go</code>: {Object.keys(files).map((f, i) => <>{i > 0 && ", "}<code>{f}</code></>)}
        </summary>
        {Object.entries(files).map(([name, src]) => (
          <figure>
            <figcaption><code>{name}</code></figcaption>
            <pre class="plain">{src}</pre>
          </figure>
        ))}
      </details>
    )
  }
  <div class="toolbar" role="toolbar" aria-label="Действия с кодом">
    {
      testMode ? (
        <>
          <button type="button" class="primary" data-action="run" data-mode="test" disabled>
            Запустить тесты
          </button>
          {example.bench && (
            <button type="button" data-action="run" data-mode="bench" disabled>
              Бенчмарки
            </button>
          )}
          {example.fuzz.map((f) => (
            <button type="button" data-action="run" data-mode="fuzz" data-fuzz={f} disabled>
              Fuzzing{example.fuzz.length > 1 && <>: {f}</>}
            </button>
          ))}
          <button type="button" data-action="run" data-mode="cover" disabled>
            Покрытие
          </button>
        </>
      ) : (
        <button type="button" class="primary" data-action="run" disabled>
          Запустить
        </button>
      )
    }
    {
      vulncheck && (
        <button type="button" data-action="run" data-mode="vulncheck" disabled>
          govulncheck
        </button>
      )
    }
    <button type="button" data-action="format" disabled>Формат</button>
    <button type="button" data-action="reset" disabled>Сбросить</button>
    <button type="button" data-action="share" disabled>Поделиться</button>
    <span class="toolbar-note muted" data-note aria-live="polite"></span>
  </div>
  <div class="result" data-result aria-live="polite"></div>
</section>

<script>
  import { format, goTest, run, RunnerError, vulncheck, type GoTestMode } from "../lib/client/api.ts";
  import { createEditor, getDoc, setDoc } from "../lib/client/editor.ts";
  import { loadDraft, saveDraft, storage } from "../lib/client/progress.ts";
  import { showError, showGoTest, showPending, showRun, showVulncheck } from "../lib/client/render.ts";
  import { fromHash, shareURL } from "../lib/client/share.ts";
  import type { EditorView } from "@codemirror/view";

  const kv = storage();

  const pending: Record<GoTestMode | "vulncheck", string> = {
    vulncheck: "govulncheck сверяет вызовы с базой уязвимостей…",
    test: "Сборка и запуск тестов…",
    bench: "Бенчмарки идут несколько секунд…",
    fuzz: "Fuzzing идёт несколько секунд…",
    cover: "Тесты с подсчётом покрытия…",
  };

  // Слот черновика: у main.go — прежний "example", чтобы старые черновики не потерялись.
  const draftSlot = (name: string) => (name === "main.go" ? "example" : `example:${name}`);

  /** Код из ссылки «Поделиться»: один файл — текст, несколько — JSON {имя: код}. */
  function sharedFiles(text: string, names: string[]): Record<string, string> | null {
    if (names.length === 1) return { [names[0]]: text };
    try {
      const parsed = JSON.parse(text);
      if (parsed && typeof parsed === "object" && names.every((n) => typeof parsed[n] === "string")) return parsed;
    } catch {
      // Ссылка из одиночного примера или битая — игнорируем.
    }
    return null;
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-playground]")) {
    const lesson = root.dataset.lesson!;
    const testMode = root.hasAttribute("data-test-mode");
    const initial: Record<string, string> = JSON.parse(root.querySelector("[data-initial]")!.textContent!);
    const extra: Record<string, string> = JSON.parse(root.querySelector("[data-files]")!.textContent!);
    const names = Object.keys(initial);
    const result = root.querySelector<HTMLElement>("[data-result]")!;
    const note = root.querySelector<HTMLElement>("[data-note]")!;
    const buttons = (a: string) => [...root.querySelectorAll<HTMLButtonElement>(`[data-action="${a}"]`)];

    // Код из ссылки «Поделиться» важнее черновика.
    const hash = await fromHash(location.hash);
    const shared = hash === null ? null : sharedFiles(hash, names);
    if (shared) note.textContent = "Код загружен из ссылки.";

    let busy = false;
    const editors = new Map<string, EditorView>();
    for (const name of names) {
      const host = root.querySelector<HTMLElement>(`[data-editor="${CSS.escape(name)}"]`)!;
      host.replaceChildren();
      editors.set(
        name,
        createEditor(host, {
          doc: shared?.[name] ?? loadDraft(kv, lesson, draftSlot(name)) ?? initial[name],
          label: names.length > 1 ? `Файл ${name}` : "Код примера",
          onSubmit: () => void doRun(testMode ? "test" : undefined),
          onChange: (doc) => saveDraft(kv, lesson, draftSlot(name), doc, initial[name]),
        }),
      );
    }
    const current = () => Object.fromEntries(names.map((n) => [n, getDoc(editors.get(n)!)]));

    async function doRun(mode?: GoTestMode | "vulncheck", fuzz?: string) {
      if (busy) return;
      busy = true;
      for (const b of buttons("run")) b.disabled = true;
      showPending(result, mode ? pending[mode] : "Сборка и запуск…");
      try {
        const files = { ...extra, ...current() };
        if (mode === "vulncheck") showVulncheck(result, await vulncheck(files, lesson));
        else if (mode) showGoTest(result, await goTest(files, mode, lesson, fuzz), mode);
        else showRun(result, await run(files, lesson));
      } catch (e) {
        showError(result, e instanceof RunnerError ? e.message : String(e));
      } finally {
        busy = false;
        for (const b of buttons("run")) b.disabled = false;
      }
    }

    for (const b of buttons("run")) {
      b.addEventListener("click", () => doRun(b.dataset.mode as GoTestMode | "vulncheck" | undefined, b.dataset.fuzz));
    }
    buttons("format")[0].addEventListener("click", async () => {
      try {
        const r = await format(current());
        const errors = Object.entries(r.errors ?? {});
        if (errors.length) showError(result, errors.map(([n, e]) => `gofmt ${n}: ${e}`).join("\n"));
        for (const [name, view] of editors) if (!r.errors?.[name]) setDoc(view, r.files[name]);
      } catch (e) {
        showError(result, e instanceof RunnerError ? e.message : String(e));
      }
    });
    buttons("reset")[0].addEventListener("click", () => {
      for (const [name, view] of editors) setDoc(view, initial[name]);
      result.replaceChildren();
      note.textContent = "Код возвращён к исходному примеру.";
    });
    buttons("share")[0].addEventListener("click", async () => {
      const files = current();
      const url = await shareURL(names.length === 1 ? files[names[0]] : JSON.stringify(files), location.href);
      history.replaceState(null, "", url);
      try {
        await navigator.clipboard.writeText(url);
        note.textContent = "Ссылка с кодом скопирована.";
      } catch {
        note.textContent = "Ссылка с кодом — в адресной строке.";
      }
    });
    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-action]")) b.disabled = false;
  }
</script>

<style>
  .hint {
    margin-top: -0.5rem;
    font-size: 0.9rem;
  }
  .file-editor {
    margin: 0 0 0.75rem;
  }
  .file-editor figcaption {
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
  }
  .labs-note {
    font-size: 0.9rem;
    border-left: 3px solid var(--accent);
    padding-left: 0.75rem;
  }
  .extra-files {
    margin: 0.5rem 0;
    font-size: 0.9rem;
  }
  .extra-files pre {
    margin: 0.25rem 0 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg-soft);
    border-radius: var(--radius);
    overflow-x: auto;
  }
  .extra-files figure {
    margin: 0.5rem 0 0;
  }
  .editor :global(.cm-editor) {
    max-height: 32rem;
  }
  .editor :global(.cm-scroller) {
    overflow: auto;
  }
</style>
