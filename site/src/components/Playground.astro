---
// Песочница: редактор с кодом примера, запуск в runner, вывод.
// Без JS остаётся подсвеченный код — пример читается и так.
import { highlight, scriptJSON } from "../lib/markdown";

interface Props {
  lesson: string;
  code: string;
  race?: boolean;
}
const { lesson, code, race } = Astro.props;
const fallback = await highlight(code.trimEnd(), "go");
---

<section class="playground" aria-label="Песочница" data-playground data-lesson={lesson}>
  <h2>Песочница</h2>
  <p class="muted hint">
    Измените пример и запустите его. <kbd>Ctrl</kbd>/<kbd>⌘</kbd>+<kbd>Enter</kbd> — запуск, <kbd>Tab</kbd> — отступ,
    <kbd>Esc</kbd> и затем <kbd>Tab</kbd> — выйти из редактора.
    {race && <> Код собирается с детектором гонок <code>-race</code>.</>}
  </p>
  <script type="application/json" data-initial set:html={scriptJSON(code)} />
  <div class="editor" data-editor>
    <Fragment set:html={fallback} />
  </div>
  <div class="toolbar" role="toolbar" aria-label="Действия с кодом">
    <button type="button" class="primary" data-action="run" disabled>Запустить</button>
    <button type="button" data-action="format" disabled>Формат</button>
    <button type="button" data-action="reset" disabled>Сбросить</button>
    <button type="button" data-action="share" disabled>Поделиться</button>
    <span class="toolbar-note muted" data-note aria-live="polite"></span>
  </div>
  <div class="result" data-result aria-live="polite"></div>
</section>

<script>
  import { format, run, RunnerError } from "../lib/client/api.ts";
  import { createEditor, getDoc, setDoc } from "../lib/client/editor.ts";
  import { loadDraft, saveDraft, storage } from "../lib/client/progress.ts";
  import { showError, showPending, showRun } from "../lib/client/render.ts";
  import { fromHash, shareURL } from "../lib/client/share.ts";

  const kv = storage();

  for (const root of document.querySelectorAll<HTMLElement>("[data-playground]")) {
    const lesson = root.dataset.lesson!;
    const initial: string = JSON.parse(root.querySelector("[data-initial]")!.textContent!);
    const host = root.querySelector<HTMLElement>("[data-editor]")!;
    const result = root.querySelector<HTMLElement>("[data-result]")!;
    const note = root.querySelector<HTMLElement>("[data-note]")!;
    const button = (a: string) => root.querySelector<HTMLButtonElement>(`[data-action="${a}"]`)!;

    // Код из ссылки «Поделиться» важнее черновика.
    const shared = await fromHash(location.hash);
    const start = shared ?? loadDraft(kv, lesson, "example") ?? initial;
    if (shared) note.textContent = "Код загружен из ссылки.";

    host.replaceChildren();
    let busy = false;
    const editor = createEditor(host, {
      doc: start,
      label: "Код примера",
      onSubmit: () => void doRun(),
      onChange: (doc) => saveDraft(kv, lesson, "example", doc, initial),
    });

    async function doRun() {
      if (busy) return;
      busy = true;
      button("run").disabled = true;
      showPending(result, "Сборка и запуск…");
      try {
        showRun(result, await run({ "main.go": getDoc(editor) }, lesson));
      } catch (e) {
        showError(result, e instanceof RunnerError ? e.message : String(e));
      } finally {
        busy = false;
        button("run").disabled = false;
      }
    }

    button("run").addEventListener("click", doRun);
    button("format").addEventListener("click", async () => {
      try {
        const r = await format({ "main.go": getDoc(editor) });
        const err = r.errors?.["main.go"];
        if (err) showError(result, `gofmt: ${err}`);
        else setDoc(editor, r.files["main.go"]);
      } catch (e) {
        showError(result, e instanceof RunnerError ? e.message : String(e));
      }
    });
    button("reset").addEventListener("click", () => {
      setDoc(editor, initial);
      result.replaceChildren();
      note.textContent = "Код возвращён к исходному примеру.";
    });
    button("share").addEventListener("click", async () => {
      const url = await shareURL(getDoc(editor), location.href);
      history.replaceState(null, "", url);
      try {
        await navigator.clipboard.writeText(url);
        note.textContent = "Ссылка с кодом скопирована.";
      } catch {
        note.textContent = "Ссылка с кодом — в адресной строке.";
      }
    });
    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-action]")) b.disabled = false;
  }
</script>

<style>
  .hint {
    margin-top: -0.5rem;
    font-size: 0.9rem;
  }
  .editor :global(.cm-editor) {
    max-height: 32rem;
  }
  .editor :global(.cm-scroller) {
    overflow: auto;
  }
</style>
